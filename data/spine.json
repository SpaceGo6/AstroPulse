  {
   "id": "dxa",
   "test": "DXA spine scan (X-ray)",
   "phase": "ground",
   "when": "L-180, L-30, landing, +6 mo, +1 yr",
   "shows": "Bone density (g/cm\u00b2), the gold standard",
   "radiation": "Very low",
   "cost": "$$",
   "crew_min": 20
  },
  {
   "id": "qct",
   "test": "CT scan (QCT) of the spine",
   "phase": "ground",
   "when": "L-30 and landing (if ordered)",
   "shows": "3D density: inner (trabecular) vs outer bone",
   "radiation": "Higher",
   "cost": "$$$",
   "crew_min": 30
  },
  {
   "id": "xray",
   "test": "Spine X-ray",
   "phase": "ground",
   "when": "L-30 and landing",
   "shows": "Vertebral fractures, posture / curve",
   "radiation": "Low",
   "cost": "$",
   "crew_min": 10
  },
  {
   "id": "us",
   "test": "Spine ultrasound (REMS-type)",
   "phase": "flight",
   "when": "Every 30 days",
   "shows": "Estimated spine density, trend between DXA scans",
   "radiation": "None",
   "cost": "$ (device once)",
   "crew_min": 15
  },
  {
   "id": "urine",
   "test": "Urine: NTx + calcium",
   "phase": "flight",
   "when": "Every 14 days",
   "shows": "Bone breakdown and calcium leaving the body (early warning)",
   "radiation": "None",
   "cost": "$",
   "crew_min": 5
  },
  {
   "id": "blood",
   "test": "Blood: calcium, BSAP, vitamin D",
   "phase": "flight",
   "when": "Every 30 days",
   "shows": "Bone building, calcium balance, vitamin D level",
   "radiation": "None",
   "cost": "$$",
   "crew_min": 10
  },
  {
   "id": "pain",
   "test": "Back pain + posture check",
   "phase": "flight",
   "when": "Daily (in check-in)",
   "shows": "Symptoms: back pain 0-10, where, hunched posture",
   "radiation": "None",
   "cost": "Free",
   "crew_min": 1
  },
  {
   "id": "exercise",
   "test": "Exercise log",
   "phase": "flight",
   "when": "Daily (from exercise device)",
   "shows": "Resistance minutes vs 150 min/week target",
   "radiation": "None",
   "cost": "Free",
   "crew_min": 0
  }
 ],
