# Copy to .env.local and change as needed.
# Where the AstroPulse backend runs (backend/: npm run dev)
VITE_API_BASE_URL=http://localhost:3001
# Which backend astronaut record belongs to each crew member: crewId:backendId,...
VITE_ASTRONAUT_MAP=maya:AST-001
# Give up on a request after this many milliseconds
VITE_API_TIMEOUT_MS=6000
