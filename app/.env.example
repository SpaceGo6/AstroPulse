# Copy to .env.local and change as needed.
# Where the AstroPulse backend runs (backend/: npm run dev).
# For the Firebase site, set this to the Vercel API URL before `npm run build`. Vite bakes it in.
VITE_API_BASE_URL=http://localhost:3001
# Which backend astronaut record belongs to each crew member: crewId:backendId,...
VITE_ASTRONAUT_MAP=chris:AST-001
# Give up on a request after this many milliseconds
VITE_API_TIMEOUT_MS=6000

# Firebase web app settings from the Firebase console. Public client values, not a deploy login.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
